generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
 
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  emails Email[]
  tasks  Task[]
  gmailAccount GmailAccount?
  activityLogs ActivityLog[]
}

model Email {
  id           String         @id @default(cuid())
  idEmail      String         @unique // ID externo del email (del JSON)
  from         String
  subject      String
  body         String
  receivedAt   DateTime       @default(now())
  createdAt    DateTime       @default(now()) // Fecha de importación del email
  processedAt  DateTime?      // Null = no procesado, fecha = procesado en esa fecha
  approvedAt   DateTime?      // Null = no aprobado aún, fecha = aprobado en esa fecha
  metadata     EmailMetadata?
  rejectionReason  String?    // Motivo del último rechazo (checkbox o texto libre)
  previousAIResult Json?      // Snapshot JSON del análisis IA descartado
  rejectedAt      DateTime?   // Fecha/hora del último rechazo de IA

  // Nivel de confianza IA y reprocesos
  reprocessCount  Int @default(0)
  confidenceScore AIConfidenceScore?

  // Asociación por usuario (multiusuario)
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isProcessable Boolean @default(true)

  @@index([from])
  @@index([subject])
  @@index([processedAt])
  @@index([approvedAt])
  @@index([rejectedAt])
  @@index([processedAt, approvedAt])
  @@index([receivedAt])
  @@index([createdAt])
  @@index([idEmail])
  @@index([userId, receivedAt])
}

model EmailMetadata {
  id              String  @id @default(cuid())
  emailId         String  @unique
  category        String?
  priority        String?
  summary         String?        // Resumen IA (5-100 chars)
  contactName     String?        // Nombre de contacto inferido
  hasTask         Boolean @default(false)
  taskDescription String?
  taskStatus      String?
  createdAt       DateTime @default(now())
  email           Email   @relation(fields: [emailId], references: [id], onDelete: Cascade)
  tasks           Task[]         // Relación 1:N con tareas extraídas por IA

  @@index([category])
  @@index([priority])
  @@index([hasTask])
  @@index([taskStatus])
  @@index([emailId])
  @@index([createdAt])
  @@index([category, priority, hasTask, taskStatus])
}

model Task {
  id              String         @id @default(cuid())
  emailMetadataId String
  emailMetadata   EmailMetadata  @relation(fields: [emailMetadataId], references: [id], onDelete: Cascade)
  description     String
  dueDate         DateTime?
  tags            String[]       // etiquetas temáticas (máx 3 sugeridas por IA)
  participants    String[]       // lista de emails involucrados
  createdAt       DateTime       @default(now())
  status          String         @default("todo") // 'todo' | 'doing' | 'done'

  // Asociación por usuario (multiusuario)
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailMetadataId])
  @@index([status])
  @@index([userId, status])
}

model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Tag {
  id          String   @id @default(cuid())
  descripcion String   @unique
  createdAt   DateTime @default(now())

  @@index([descripcion])
}

model AIConfidenceScore {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación 1:1 con Email
  emailId String @unique
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  // Score general
  overallScore Float // 0-100

  // Desglose individual
  clarityScore           Float
  patternMatchScore      Float
  completenessScore      Float
  priorityCoherenceScore Float
  taskValidityScore      Float
  tagsQualityScore       Float
  feedbackPenalty        Float

  // Interpretación
  interpretation   String  // "excelente" | "bueno" | "aceptable" | "dudoso" | "bajo"
  requiresReview   Boolean
  reviewPriority   Int     // 0-100, inversamente proporcional a overallScore
  confidenceReason String  // Razón legible para el usuario

  // Opcional: JSON completo para debugging
  breakdown Json?

  @@index([overallScore])
  @@index([reviewPriority])
}

model GmailAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  scope        String
  tokenType    String
  expiryDate   DateTime
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  // Usuario que ejecutó la acción
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Tipo de actividad (enum limitado)
  activityType String // "email_import" | "ai_processing" | "kanban_update"
  
  // Metadata específica según tipo (JSON flexible)
  metadata Json
  
  // Resultado de la operación
  status String // "success" | "partial_success" | "error"
  
  // Mensaje descriptivo para el usuario
  description String
  
  // Costo aproximado (solo para ai_processing)
  estimatedCost Float? // En centavos de USD ($0.01 = 1 centavo)
  
  // Opcional: relacionar con entidades específicas
  relatedEmailIds String[] // IDs de emails involucrados
  relatedTaskIds  String[] // IDs de tareas involucradas
  
  @@index([userId, createdAt])
  @@index([activityType, userId])
  @@index([createdAt])
}
